msgid "Firmware file {} was missing when the computer started, but it's installed now. Restarting should fix this."
msgstr "컴퓨터가 시작될 때 펌웨어 파일 {}이(가) 없었지만 지금은 설치되어 있습니다. 다시 시작하면 해결됩니다."

msgid "The driver needs a firmware file that isn't installed: {}. It comes in the {} package."
msgstr "드라이버에 필요한 펌웨어 파일 {}이(가) 설치되어 있지 않습니다. {} 패키지에 포함되어 있습니다."

msgid "The driver needs a firmware file that isn't installed: {}"
msgstr "드라이버에 필요한 펌웨어 파일이 설치되어 있지 않습니다: {}"

msgid "A device plugged in here couldn't connect. This is usually a bad cable, a faulty device, or not enough power. Try another cable or port."
msgstr "여기에 연결한 장치를 연결하지 못했습니다. 보통 케이블 불량, 장치 고장 또는 전원 부족이 원인입니다. 다른 케이블이나 포트를 사용해 보세요."

msgid "A device plugged in here couldn't connect ({}). This is usually a bad cable, a faulty device, or not enough power. Try another cable or port."
msgstr "여기에 연결한 장치를 연결하지 못했습니다({}). 보통 케이블 불량, 장치 고장 또는 전원 부족이 원인입니다. 다른 케이블이나 포트를 사용해 보세요."

msgid "This USB port reported drawing too much power. The device plugged into it may be faulty or need its own power supply."
msgstr "이 USB 포트가 전력 과다 사용을 보고했습니다. 연결한 장치가 고장 났거나 자체 전원이 필요할 수 있습니다."

msgid "The {} driver couldn't start this device ({})."
msgstr "{} 드라이버가 이 장치를 시작하지 못했습니다({})."

msgid "it wasn't allowed to"
msgstr "허용되지 않았습니다"

msgid "a file it needs is missing"
msgstr "필요한 파일이 없습니다"

msgid "the device didn't respond correctly"
msgstr "장치가 올바르게 응답하지 않았습니다"

msgid "the device was temporarily unavailable"
msgstr "장치를 일시적으로 사용할 수 없었습니다"

msgid "the computer ran out of memory for it"
msgstr "컴퓨터의 메모리가 부족했습니다"

msgid "the device was already in use"
msgstr "장치가 이미 사용 중이었습니다"

msgid "the device wasn't found when the driver looked for it"
msgstr "드라이버가 장치를 찾지 못했습니다"

msgid "the device sent something the driver didn't expect"
msgstr "장치가 드라이버가 예상하지 못한 정보를 보냈습니다"

msgid "the device stopped responding"
msgstr "장치가 응답하지 않습니다"

msgid "the connection kept failing"
msgstr "연결이 계속 실패했습니다"

msgid "this device model isn't supported by the driver"
msgstr "이 장치 모델은 드라이버에서 지원되지 않습니다"

msgid "the device didn't respond in time"
msgstr "장치가 제때 응답하지 않았습니다"

msgid "it was waiting on another part that never became ready"
msgstr "준비되지 않은 다른 부분을 기다리고 있었습니다"

msgid "an unexpected error"
msgstr "예기치 않은 오류"

msgid "Couldn't read the kernel's list of drivers, so hwsight can't tell whether a driver is available for devices without one."
