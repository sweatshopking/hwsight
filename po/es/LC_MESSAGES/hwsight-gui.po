msgid "A device plugged in here couldn't connect. This is usually a bad cable, a faulty device, or not enough power. Try another cable or port."
msgstr "Un dispositivo conectado aquí no pudo conectarse. Normalmente se debe a un cable defectuoso, un dispositivo averiado o falta de energía. Prueba otro cable o puerto."

msgid "A device plugged in here couldn't connect ({}). This is usually a bad cable, a faulty device, or not enough power. Try another cable or port."
msgstr "Un dispositivo conectado aquí no pudo conectarse ({}). Normalmente se debe a un cable defectuoso, un dispositivo averiado o falta de energía. Prueba otro cable o puerto."

msgid "This USB port reported drawing too much power. The device plugged into it may be faulty or need its own power supply."
msgstr "Este puerto USB informó de un consumo excesivo. El dispositivo conectado puede estar averiado o necesitar su propia fuente de alimentación."

msgid "The {} driver couldn't start this device ({})."
msgstr "El controlador {} no pudo iniciar este dispositivo ({})."

msgid "it wasn't allowed to"
msgstr "no se le permitió"

msgid "a file it needs is missing"
msgstr "falta un archivo necesario"

msgid "the device didn't respond correctly"
msgstr "el dispositivo no respondió correctamente"

msgid "the device was temporarily unavailable"
msgstr "el dispositivo no estaba disponible temporalmente"

msgid "the computer ran out of memory for it"
msgstr "el ordenador se quedó sin memoria"

msgid "the device was already in use"
msgstr "el dispositivo ya estaba en uso"

msgid "the device wasn't found when the driver looked for it"
msgstr "el controlador no encontró el dispositivo"

msgid "the device sent something the driver didn't expect"
msgstr "el dispositivo envió algo inesperado al controlador"

msgid "the device stopped responding"
msgstr "el dispositivo dejó de responder"

msgid "the connection kept failing"
msgstr "la conexión fallaba continuamente"

msgid "this device model isn't supported by the driver"
msgstr "el controlador no admite este modelo de dispositivo"

msgid "the device didn't respond in time"
msgstr "el dispositivo no respondió a tiempo"

msgid "it was waiting on another part that never became ready"
msgstr "estaba esperando otra parte que nunca estuvo lista"

msgid "an unexpected error"
msgstr "un error inesperado"

