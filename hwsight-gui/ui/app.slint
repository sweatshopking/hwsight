// hwsight main window.
//
// Layout (left to right): device list grouped by category | details of the selected
// device. A header shows the summary and a refresh button. Everything visual reads its
// colours, sizes, and fonts from `Theme`, so themes can be swapped without touching
// components.

import { ScrollView, Button, ListView, Switch } from "std-widgets.slint";
import { Theme, DeviceItem, FixItem } from "theme.slint";
import { CategoryHeader } from "components/category-header.slint";
import { DeviceRow } from "components/device-row.slint";
import { DetailsPanel } from "components/details-panel.slint";
import { AccentButton } from "components/accent-button.slint";
import { NotesBanner } from "components/notes-banner.slint";
import { StatusPill } from "components/status-pill.slint";
import { SearchBox } from "components/search-box.slint";

// Re-exported so the Rust side can set theme tokens and build device items.
export { Theme, DeviceItem, FixItem }

// One row of the device list: either a category heading or a device.
export struct Row {
    is-header: bool,
    // Heading rows: the category name and how many devices it holds.
    header-text: string,
    header-count: int,
    // Device rows: index into `devices`.
    device: int,
}

export component AppWindow inherits Window {
    title: "hwsight";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.background;

    // Filled by Rust.
    in property <[DeviceItem]> devices;
    in property <[Row]> rows;
    in property <string> summary;          // e.g. "51 devices, no problems found"
    in property <int> problem-count;
    in property <[string]> notes;          // things that limited the scan
    in property <bool> scanning;
    in-out property <string> query;
    in-out property <bool> only-problems;

    // Index into `devices` of the selected device, or -1.
    in-out property <int> selected: -1;

    callback refresh();
    callback filter-changed();

    changed query => { root.filter-changed(); }
    changed only-problems => { root.filter-changed(); }

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.gap;

        // Each item sits in a centred VerticalLayout so it keeps its own size instead of
        // stretching to fill the row.
        HorizontalLayout {
            height: 56px;
            spacing: 16px;
            // Text can't be filled with a gradient (the renderer draws nothing), so the
            // accent gradient goes on a small bar beside the name.
            HorizontalLayout {
                spacing: 10px;
                horizontal-stretch: 0;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 26px;
                        border-radius: 3px;
                        background: @linear-gradient(180deg, Theme.accent-start 0%, Theme.accent-end 100%);
                        drop-shadow-blur: 10px;
                        drop-shadow-color: Theme.accent-glow;
                    }
                }
                Text {
                    text: "hwsight";
                    color: Theme.text;
                    font-size: Theme.font-hero;
                    font-weight: 800;
                    vertical-alignment: center;
                }
            }
            if root.scanning : Text {
                text: "Scanning your hardware...";
                color: Theme.text-muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            if !root.scanning : VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                StatusPill {
                    kind: root.problem-count == 0 ? "ok" : "warn";
                    text: root.problem-count == 0 ? "No problems found" : root.summary;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                AccentButton {
                    text: root.scanning ? "Scanning..." : "Scan again";
                    enabled: !root.scanning;
                    clicked => { root.refresh(); }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                horizontal-stretch: 2;
                min-width: 340px;
                // Shown over the empty list when a search or filter matches nothing.
                // (Inside the list's loop it could never appear: no rows, no loop.)
                if root.rows.length == 0 && !root.scanning : Text {
                    y: 60px;
                    width: parent.width;
                    height: parent.height - 60px;
                    text: "Nothing matches.";
                    color: Theme.text-faint;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Theme.gap;
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 4px;
                        SearchBox {
                            text <=> root.query;
                            horizontal-stretch: 1;
                        }
                        Switch {
                            text: "Only problems";
                            checked <=> root.only-problems;
                        }
                    }
                    ListView {
                        // Each item needs its own height: children placed with `if`
                        // don't size their parent, so without it every row is 0px tall.
                        for row in root.rows: Rectangle {
                            height: row.is-header ? 40px : 52px;
                            if row.is-header : CategoryHeader {
                                width: parent.width;
                                text: row.header-text;
                                count: row.header-count;
                            }
                            if !row.is-header : DeviceRow {
                                width: parent.width;
                                device: root.devices[row.device];
                                selected: root.selected == row.device;
                                clicked => { root.selected = row.device; }
                            }
                        }
                    }
                }
            }
            DetailsPanel {
                device: root.selected >= 0 ? root.devices[root.selected] : {
                    name: "",
                    vendor: "",
                    category: "",
                    status-kind: "neutral",
                    status-text: "",
                    driver: "",
                    hardware-id: "",
                    address: "",
                    bus: "",
                    why: "",
                    fixes: [],
                    note: "",
                    description: "",
                    unrecognized: false
                };
                has-device: root.selected >= 0;
                horizontal-stretch: 3;
            }
        }
        NotesBanner {
            notes: root.notes;
        }
    }
}
