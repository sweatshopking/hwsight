import { ScrollView } from "std-widgets.slint";
import { Theme, DeviceItem, FixItem, SoftwareItem, DetailItem, DetailGroupItem } from "../theme.slint";
import { StatusPill } from "status-pill.slint";
import { StatusDot } from "status-dot.slint";
import { LevelSwitch } from "level-switch.slint";
import { AccentButton } from "accent-button.slint";

export component DetailsPanel inherits Rectangle {
    in property <DeviceItem> device;
    in property <bool> has-device;
    // 0 = Simple, 1 = More details, 2 = Technical.
    in property <int> level;
    callback set-level(int);
    callback copy-report();
    property <bool> copied;
    property <color> status-colour: root.device.status-kind == "ok" ? Theme.ok
        : root.device.status-kind == "warn" ? Theme.warn
        : root.device.status-kind == "error" ? Theme.error
        : Theme.neutral;
    background: Theme.surface;
    border-radius: Theme.radius;

    VerticalLayout {
        padding: 24px;
        if !root.has-device : Text {
            text: @tr("Select a device to see its details");
            color: Theme.text-faint;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
            vertical-stretch: 1;
        }
        if root.has-device : ScrollView {
        VerticalLayout {
            // Pack from the top; without this the items spread to fill the panel.
            alignment: start;
            spacing: Theme.gap;
            Text {
                text: root.device.name;
                color: Theme.text;
                font-size: Theme.font-hero;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.device.vendor != "" : Text {
                text: root.device.vendor;
                color: Theme.text-muted;
                font-size: Theme.font-body;
                overflow: elide;
            }
            // Wrapped so the pill fits its text instead of stretching across the panel.
            HorizontalLayout {
                alignment: start;
                StatusPill {
                    kind: root.device.status-kind;
                    text: root.device.status-text;
                }
            }
            LevelSwitch {
                level: root.level;
                selected(level) => { root.set-level(level); }
            }
            if root.device.description != "" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("WHAT IT DOES");
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    letter-spacing: 1px;
                }
                Text {
                    text: root.device.description;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
            }
            // Things that work but could be better, or are wrong: shown at the Simple level,
            // where the details below aren't. (The other levels show them in place.)
            if root.level == 0 && root.device.findings.length > 0 : Rectangle {
                background: root.status-colour.with-alpha(0.10);
                border-width: 1px;
                border-color: root.status-colour.with-alpha(0.35);
                border-radius: Theme.radius-small;
                VerticalLayout {
                    padding: 16px;
                    spacing: Theme.gap;
                    Text {
                        text: root.device.status-kind == "error" ? @tr("Needs attention") : @tr("Could be better");
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 700;
                    }
                    for finding in root.device.findings : VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 4px;
                                StatusDot { kind: finding.kind; }
                            }
                            Text {
                                text: finding.value;
                                color: Theme.text;
                                font-weight: 700;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                        if finding.explanation != "" : Text {
                            text: finding.explanation;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if finding.command != "" : Rectangle {
                            background: Theme.background;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 10px;
                                TextInput {
                                    text: finding.command;
                                    read-only: true;
                                    single-line: true;
                                    color: Theme.highlight;
                                    font-family: "monospace";
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
            if root.device.why != "" : Rectangle {
                background: root.status-colour.with-alpha(0.10);
                border-width: 1px;
                border-color: root.status-colour.with-alpha(0.35);
                border-radius: Theme.radius-small;
                VerticalLayout {
                    padding: 16px;
                    spacing: Theme.gap;
                    Text {
                        text: @tr("What's wrong");
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 700;
                    }
                    Text {
                        text: root.device.why;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }
            }
            if root.device.fixes.length > 0 : Rectangle {
                background: Theme.surface-raised;
                border-radius: Theme.radius-small;
                VerticalLayout {
                    padding: 16px;
                    spacing: Theme.gap;
                    Text {
                        text: @tr("How to fix");
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 700;
                    }
                    for fix[i] in root.device.fixes : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            // Number the steps only when there's more than one.
                            if root.device.fixes.length > 1 : Text {
                                text: (i + 1) + ".";
                                color: Theme.text-muted;
                                font-weight: 700;
                                vertical-alignment: top;
                            }
                            Text {
                                text: fix.text;
                                color: Theme.text;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                        if fix.command != "" : Rectangle {
                            background: Theme.background;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 10px;
                                TextInput {
                                    text: fix.command;
                                    read-only: true;
                                    single-line: true;
                                    color: Theme.highlight;
                                    font-family: "monospace";
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
            if root.device.software.length > 0 : Rectangle {
                background: Theme.surface-raised;
                border-radius: Theme.radius-small;
                VerticalLayout {
                    padding: 16px;
                    spacing: Theme.gap;
                    Text {
                        text: @tr("USEFUL SOFTWARE");
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }
                    for software in root.device.software : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: software.name;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 700;
                                horizontal-stretch: 1;
                            }
                            if software.installed : StatusPill {
                                kind: "ok";
                                text: @tr("Installed");
                            }
                        }
                        Text {
                            text: software.what;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if software.command != "" : Rectangle {
                            background: Theme.background;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 10px;
                                TextInput {
                                    text: software.command;
                                    read-only: true;
                                    single-line: true;
                                    color: Theme.highlight;
                                    font-family: "monospace";
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        if software.how-to-get != "" : Text {
                            text: software.how-to-get;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: software.homepage;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if root.device.note != "" : Text {
                text: root.device.note;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            if root.level > 0 : VerticalLayout {
                spacing: 0px;
                if root.device.details.length == 0 : Text {
                    text: @tr("No more details could be read for this device.");
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                for group in root.device.details : VerticalLayout {
                    if root.level >= 2 || group.more-count > 0 : VerticalLayout {
                        padding-top: Theme.gap;
                        spacing: 10px;
                        Text {
                            text: group.title;
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                        for item in group.items : VerticalLayout {
                            if root.level >= 2 || !item.technical : VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: item.label;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if item.kind != "neutral" : VerticalLayout {
                                        alignment: start;
                                        padding-top: 4px;
                                        StatusDot { kind: item.kind; }
                                    }
                                    Text {
                                        text: item.value;
                                        color: Theme.text;
                                        font-size: Theme.font-body;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                                if item.explanation != "" : Text {
                                    text: item.explanation;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                                if item.command != "" : Rectangle {
                                    background: Theme.background;
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding: 10px;
                                        TextInput {
                                            text: item.command;
                                            read-only: true;
                                            single-line: true;
                                            color: Theme.highlight;
                                            font-family: "monospace";
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                if root.level >= 2 && item.raw != "" : Text {
                                    text: @tr("As read: {}", item.raw);
                                    color: Theme.text-faint;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                                if root.level >= 2 && item.source != "" : Text {
                                    text: item.source;
                                    color: Theme.text-faint;
                                    font-size: Theme.font-small;
                                    font-family: "monospace";
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: Theme.gap;
                AccentButton {
                    text: root.copied ? @tr("Copied") : @tr("Copy for a forum post");
                    clicked => {
                        root.copied = true;
                        root.copy-report();
                    }
                }
                Text {
                    text: @tr("Copies a short report about this device. Your user name and computer name are removed.");
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
            }
            copy-timer := Timer {
                interval: 2s;
                running: root.copied;
                triggered => { root.copied = false; }
            }
            VerticalLayout {
                spacing: Theme.gap;
                Text {
                    text: @tr("DETAILS");
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    letter-spacing: 1px;
                }
                GridLayout {
                    spacing: Theme.gap;
                    Row {
                        Text { text: @tr("Type"); color: Theme.text-muted; }
                        TextInput {
                            text: root.device.category;
                            read-only: true;
                            single-line: true;
                            color: Theme.text;
                            font-size: Theme.font-body;
                        }
                    }
                    Row {
                        Text { text: @tr("Driver"); color: Theme.text-muted; }
                        TextInput {
                            text: root.device.driver == "" ? @tr("None") : root.device.driver;
                            read-only: true;
                            single-line: true;
                            color: Theme.text;
                            font-size: Theme.font-body;
                        }
                    }
                    Row {
                        Text { text: @tr("Hardware ID"); color: Theme.text-muted; }
                        TextInput {
                            text: root.device.hardware-id;
                            read-only: true;
                            single-line: true;
                            color: Theme.text;
                            font-size: Theme.font-body;
                        }
                    }
                    Row {
                        Text { text: @tr("Connection"); color: Theme.text-muted; }
                        TextInput {
                            text: root.device.bus;
                            read-only: true;
                            single-line: true;
                            color: Theme.text;
                            font-size: Theme.font-body;
                        }
                    }
                    Row {
                        Text { text: @tr("Address"); color: Theme.text-muted; }
                        TextInput {
                            text: root.device.address;
                            read-only: true;
                            single-line: true;
                            color: Theme.text;
                            font-size: Theme.font-body;
                        }
                    }
                }
                if root.device.unrecognized : Text {
                    text: @tr("This device isn't in the device database yet. Its hardware ID above can be searched for online.");
                    color: Theme.text-faint;
                    wrap: word-wrap;
                }
            }
        }
    }
    }
}
